# Houses Configuration

# Google Sheets — paste the service account JSON as a single line
# HOUSES_GOOGLE_SHEETS_SERVICE_ACCOUNT={"type":"service_account","project_id":...}

# The spreadsheet ID from your sheet URL
# HOUSES_SHEET_ID=...

# API Keys
TFL_API_KEY=
HEIGIT_API_KEY=
PLACES_API_KEY=
OPENROUTER_API_KEY=

# Google OAuth (web client) — set HOUSES_GOOGLE_WEB_CLIENT_ID + HOUSES_GOOGLE_WEB_CLIENT_SECRET + HOUSES_SESSION_SECRET
# Device-flow client for headless login (tools/capture_dom.py --login):
# create a "TVs and Limited Input devices" OAuth client in Google Cloud Console
# (no redirect URIs needed). Whether it has a client secret depends on the
# console: if one is shown, set it here; if not, leave it empty. The code
# sends the secret only when configured (an empty client_secret in the token
# request can make Google reject it with invalid_client).
# HOUSES_GOOGLE_DEVICE_CLIENT_ID=
# HOUSES_GOOGLE_DEVICE_CLIENT_SECRET=  (only if your device client has one)

# Commute constants (defaults: 46 weeks, Simon 1d/wk, Lorena 2d/wk)
# HOUSES_WORKING_WEEKS_PER_YEAR=46
# HOUSES_WEEKLY_SIMON_TRIPS=1
# HOUSES_WEEKLY_LORENA_TRIPS=2
# HOUSES_WEEKLY_BRACKNELL_TRIPS=1
