# Normalise line endings (skill://new-repo-scaffold §4).
* text=auto eol=lf

# Generated machine output — stored in git but excluded from every review path.
# -diff: git treats these as binary, so no diff consumer (git diff, git log -p,
#        GitHub PR API, patch tools) ever receives their content.
# linguist-generated: GitHub collapses them in the PR diff view.
data/commute/*.json -diff
data/commute/*.txt -diff
data/commute/*.json linguist-generated=true
data/commute/*.txt linguist-generated=true
