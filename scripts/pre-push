#!/usr/bin/env sh
# Pre-push hook: run the same gate as CI — `make check` (lint + typecheck).
#
# Install: `make install-hooks` (copies this file to .git/hooks/pre-push).
# Re-run `make install-hooks` after pulling updates — this file is the
# single source of truth; the copy in .git/hooks is not versioned.
#
# Why `make check` and not the tools directly: CI runs `make check` (via
# `make test`, which includes lint-check + typecheck) — delegating here
# means the hook and CI can never drift apart, exactly like the pre-commit
# hook delegates to `make lint-check typecheck-py`. The deadlock that once
# forced the hook to call the tools directly is gone: check targets depend
# on `deps` (uv sync + npm install), never on install-hooks.
#
# The skip check looks at the COMMITS being pushed (`git rev-list --not
# --remotes`), not the working tree.  The tree is always clean right after
# committing, so a tree-based check silently skipped every normal push —
# pyrefly/typecheck failures reached CI first (2026-08-21, PR 66).
# A push that touches Python/TS/Vue sources or the typecheck config runs
# the full gate.

set -e

if [ -z "$(git rev-list HEAD --not --remotes -- '*.py' '*.ts' '*.vue' '*.js' 'pyrefly.toml')" ]; then
    exit 0
fi

if [ ! -x .venv/bin/ruff ]; then
    echo "pre-push: .venv/bin/ruff not found — run 'make setup' first" >&2
    exit 1
fi

# The shared gate — same command CI runs.
make check
