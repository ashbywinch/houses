#!/usr/bin/env sh
# Pre-commit hook: gitleaks + ruff + stylelint + full typecheck (pyrefly
# baseline gate + vue-tsc build mode) on staged content.
#
# Install: `make install-hooks` (copies this file to .git/hooks/pre-commit).
# Re-run `make install-hooks` after pulling updates — this file is the
# single source of truth; the copy in .git/hooks is not versioned.
#
# Fail fast: a staged file that fails ruff, the pyrefly baseline gate,
# or vue-tsc blocks the commit with the same output as `make check`.
# The hook never mutates your working tree — auto-fixing is `make
# format` / `ruff check --fix`.
#
#
# gitleaks scans the staged content (not diffs), so secrets in files marked
# -diff / linguist-generated in .gitattributes stay caught even though no
# diff-based reviewer can see them. If gitleaks is not installed, the check
# is skipped with a warning — install it with `brew install gitleaks` or
# `go install github.com/gitleaks/gitleaks/v8@latest`.

set -e

# gitleaks runs FIRST and unconditionally: the Python-only guard below must
# never skip the secret scan for commits that touch no .py files (e.g. the
# -diff-marked data/commute/*.json, which no diff-based reviewer can see).
if command -v gitleaks >/dev/null 2>&1; then
    # v8's pre-commit command is `protect --staged`; `git --staged` is invalid
    # (the --staged flag belongs to protect) — use the documented form directly.
    gitleaks protect --staged -v
else
    echo "pre-commit: gitleaks not installed — skipping secret scan (install for full protection)" >&2
fi

files=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
if [ -z "$files" ]; then
    exit 0
fi

if [ ! -x .venv/bin/ruff ]; then
    echo "pre-commit: .venv/bin/ruff not found — run 'make setup' first" >&2
    exit 1
# Delegate to the shared make targets so the hook and CI can never drift
# apart: lint-check (ruff + frontend stylelint) plus the FULL typecheck
# (pyrefly baseline gate + vue-tsc build mode) — the same gate CI runs,
# so nothing CI can catch is ever left for CI to find first.
make lint-check typecheck
fi
