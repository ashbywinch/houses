# /etc/systemd/system/houses.service — THE app unit (one per box).
#
# One instance, one app, port 8765: roles (owner/standby) rotate with the L4
# forwarding rule's target, not with the unit or the port. See
# tools/deploy/run-instance.sh and docs/anti-fragile-rollout-plan.md.
[Unit]
Description=Houses app (port 8765)
After=network-online.target houses-chrome.service
Wants=network-online.target
# R3 (2026-09-07 incident): stop a crash-loop instead of rebuilding forever.
# Restart=always + no cap let one bad run hammer the box for 13 hours.
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
User=ubuntu
WorkingDirectory=/opt/houses/app
# Secrets come from a root-only env file (chmod 600 — a systemd unit file is
# world-readable, so never put secrets in Environment= lines here). Must be
# STRICT KEY=VALUE: no quotes, no export, no $ references.
EnvironmentFile=/etc/houses.env
ExecStart=/bin/sh /opt/houses/run-instance.sh
# R3 — memory containment: one runaway process must kill THIS unit, never the
# guest. Without caps, the 2026-09-07 global OOM reaped a neighbouring process
# AND the guest's networking — prod down four days while the VM reported RUNNING.
MemoryHigh=384M
MemoryMax=512M
# The app must never be the kernel's first OOM candidate.
OOMScoreAdjust=-800
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
