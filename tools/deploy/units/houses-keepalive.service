# /etc/systemd/system/houses-keepalive.service — keeps the Always-Free box
# above Oracle's idle-reclaim thresholds (CPU 95th-pct <20% over 7 days).
# Runs as root: reads /etc/houses.env (root-only) for the session secret.
[Unit]
Description=Houses keepalive (property refresh + CPU exercise)
After=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/sh /opt/houses/keepalive.sh
