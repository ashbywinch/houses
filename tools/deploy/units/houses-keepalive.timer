# /etc/systemd/system/houses-keepalive.timer — every 30 min.
# 3 cores busy 600s per 1800s window = 25% average CPU util, above the 20%
# idle threshold; the property regenerations add genuine load on top.
[Unit]
Description=Run the houses keepalive every 30 minutes

[Timer]
OnCalendar=*:0/30
RandomizedDelaySec=300
Persistent=true
Unit=houses-keepalive.service

[Install]
WantedBy=timers.target
